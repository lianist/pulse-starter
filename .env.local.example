# PULSE 실습용 키 파일의 예시입니다.
# npm run doctor 를 실행하면 이 내용 그대로 .env.local 이 만들어집니다.
# 키는 수업에서 받아 .env.local 의 = 뒤에 붙여넣습니다. 따옴표와 띄어쓰기는 넣지 않습니다.
# .env.local 은 GitHub에 올라가지 않습니다. 키를 채팅, 코드, 스크린샷에 남기지 않습니다.

# Claude API 키 (조별로 받습니다)
# 일부러 ANTHROPIC_API_KEY 가 아닌 이름을 씁니다. 그 이름이 컴퓨터 환경변수로 잡히면
# Claude Code가 구독 대신 이 키로 결제할 수 있기 때문입니다.
# 코드에서는 new Anthropic({ apiKey: process.env.PULSE_CLAUDE_KEY }) 처럼 직접 넘깁니다.
PULSE_CLAUDE_KEY=

# 서비스 안에서 부를 Claude 모델
PULSE_MODEL=claude-haiku-5-5

# Upstage API 키 (문서 인식)
UPSTAGE_API_KEY=
